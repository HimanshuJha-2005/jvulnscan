<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter xmlns="https://github.com/spotbugs/filter/3.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">
    <!--
        Model classes (Finding, ScanResult, ServiceFingerprint, ScannerConfig,
        CheckMetadata, ServiceProbe) are Jackson-serialized DTOs: getters must
        expose the underlying collections for serialization, and constructors
        must accept caller-owned collections. Callers treat results as
        read-only snapshots. The registries that own live state
        (CheckRegistry, ConfigManager via ScannerConfig) defensively operate on
        ConcurrentHashMap-backed structures, not these DTOs.
    -->
    <Match>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>
    <!--
        ScanStateStore is final and its constructor fully handles init
        failures (logs and continues degraded without persistence). No
        subclassing or finalizer attack surface remains.
    -->
    <Match>
        <Class name="com.himanshu.vulnscan.persistence.ScanStateStore"/>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>
    <!--
        HttpProbe.startTls casts the socket returned by
        SSLSocketFactory.createSocket(Socket, String, int, boolean) to
        SSLSocket. That factory is documented to return an SSLSocket and the
        cast is required by the API it overrides; no other factory is used.
    -->
    <Match>
        <Class name="com.himanshu.vulnscan.check.net.HttpProbe"/>
        <Method name="startTls"/>
        <Bug pattern="BC_UNCONFIRMED_CAST_OF_RETURN_VALUE"/>
    </Match>
</FindBugsFilter>
